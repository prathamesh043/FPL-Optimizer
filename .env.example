# Host user id for mounted volumes (macOS/Windows can keep 50000)
AIRFLOW_UID=50000

# Shared JWT secret for Airflow 3 Execution API (must match across all services)
AIRFLOW__API_AUTH__JWT_SECRET=fpl-optimizer-local-jwt-secret

# Airflow UI login (created on first init)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Supabase / Postgres credentials used by the FPL DAG
SUPABASE_USER=
SUPABASE_PASSWORD=
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DB=postgres
